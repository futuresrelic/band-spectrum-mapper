      ],
      "npcs": [
        {
          "name": "Felix the Keeper",
          "role": "quest_giver",
          "positionX": 8,
          "positionY": 3,
          "defaultDialogue": [
            { "text": "Thank goodness you're here. I'm Felix — I've been the Keeper of this archive for thirty years.", "speakerName": "Felix the Keeper" },
            { "text": "Last week, one of our interns lost the Vault key somewhere in the Stacks. And now the Lost Album — our most precious recording — is locked inside.", "speakerName": "Felix the Keeper" },
            { "text": "I need you to find that key. It's somewhere in the Stacks to the east. Once you have it, the Vault door should open.", "speakerName": "Felix the Keeper" },
            { "text": "And when you reach the Vault... recover the Lost Album. Please. This music cannot be forgotten.", "speakerName": "Felix the Keeper" }
          ]
        }
      ],
      "beats": [
        {
          "arcSlug": "tsa-into-the-archive",
          "type": "narration",
          "content": {
            "lines": [
              { "text": "You step through the doors of the Sound Archive." },
              { "text": "The air is thick with the smell of old vinyl and quiet history. Rows of shelves stretch to the ceiling, filled with records, tapes, and forgotten music." },
              { "text": "A figure waves you over from behind a large desk. He looks worried." }
            ]
          },
          "unlockCondition": { "type": "always" },
          "order": 1
        }
      ],
      "doors": [],
      "switches": [],
      "puzzles": []
    },

