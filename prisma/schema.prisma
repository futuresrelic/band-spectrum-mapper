// ---------------------------------------------------------------------------

model LyricChainScore {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chainLength Int      // number of (word, song) pairs completed
  chainJson   String   // JSON-serialised chain steps for review
  bandScope   String?  // comma-sep band IDs; null = all
  hardMode    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([chainLength])
  @@index([userId])
  @@map("lyric_chain_scores")
}

// ---------------------------------------------------------------------------
// Musical Structure Spectrum — parallel to the lyric/emotional spectrum.
// Scores how the MUSIC ITSELF is built (independent of lyrics or emotional content).
// Works well for instrumental bands; also adds depth to lyrical songs.
// ---------------------------------------------------------------------------

model SongMusicScore {
  id                   String   @id @default(cuid())
  songId               String   @unique
  model                String
  rhythmicComplexity   Float    @default(0)  // 0=steady 4/4, 10=polymetric/polyrhythmic
  harmonicDepth        Float    @default(0)  // 0=power chords/triads, 10=microtonal/jazz chromatic
  structuralComplexity Float    @default(0)  // 0=verse-chorus pop, 10=through-composed prog suite
  sonicDensity         Float    @default(0)  // 0=sparse/minimal, 10=dense/orchestral/layered
  tempoEnergy          Float    @default(0)  // 0=slow/meditative/ambient, 10=fast/relentless
  tonalDarkness        Float    @default(0)  // 0=bright/major/uplifting, 10=dark/dissonant/atonal
  rationale            String
  contextJson          String   @default("{}")  // sources used: lyrics?, audioFeatures?, researchSummary?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("song_music_scores")
}

