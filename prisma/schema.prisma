  title       String
  description String?
  adventureId String?  // Phase Z.4 — optional adventure grouping
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  adventure BandRpgAdventure? @relation(fields: [adventureId], references: [id], onDelete: SetNull)
  beats     BandRpgStoryBeat[]

  @@unique([adventureId, slug])
  @@map("band_rpg_story_arcs")
}

enum BandRpgBeatType {
  dialogue
  narration
  cutscene
  choice
  unlock
  trigger

  @@map("band_rpg_beat_type")
}

model BandRpgStoryBeat {
  id          String          @id @default(cuid())
  arcId       String?
  levelId     String?
  type        BandRpgBeatType
  content     Json            @default("{}") // text, choices, branch targets, speaker
  unlockCondition Json        @default("{}")
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  arc   BandRpgStoryArc? @relation(fields: [arcId],   references: [id], onDelete: SetNull)
  level BandRpgLevel?    @relation(fields: [levelId], references: [id], onDelete: SetNull)

  @@map("band_rpg_story_beats")
}

model BandRpgTimelineEvent {
  id          String   @id @default(cuid())
  title       String
  type        String   // "level" | "quest" | "story" | "boss" | "unlock"
  refId       String?  // level/quest/beat ID
  order       Int      @default(0)
  isRequired  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("band_rpg_timeline_events")
}

model BandRpgNpc {
  id             String   @id @default(cuid())
  levelId        String
  name           String
  role           String?  // "quest_giver" | "merchant" | "band_member" | "ambient"
  faction        String?
  portraitUrl    String?
  characterSkinId String? // Reference to PlatformerCharacterSkin
  defaultDialogue Json   @default("[]") // [{text, speakerName, portraitUrl}]
  positionX      Int      @default(0)
  positionY      Int      @default(0)
  bandMemberId        String?  // Optional BandMember reference
  visibilityCondition Json?    // { type: WorldConditionType, targetId?: string } — hide NPC until met
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  level BandRpgLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@map("band_rpg_npcs")
}

enum BandRpgItemType {
  collectible
  key_item
  quest_item
  power_up
  lore_item
  album_artifact
  song_artifact
  cosmetic

  @@map("band_rpg_item_type")
}

model BandRpgItem {
  id          String          @id @default(cuid())
  slug        String          // unique per adventure — see @@unique below
  name        String
  description String?
  type        BandRpgItemType
  iconUrl     String?
  spriteUrl   String?
  rarity      String          @default("common") // "common" | "rare" | "epic" | "legendary"
  scoreValue  Int             @default(0)
  adventureId String?         // Phase Z.4 — optional adventure grouping
  bandId      String?
  albumId     String?
  songId      String?
  isVisible   Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  adventure BandRpgAdventure? @relation("AdventureItems", fields: [adventureId], references: [id], onDelete: SetNull)
  levels    BandRpgLevel[]    @relation("LevelItems")

  @@unique([adventureId, slug])
  @@map("band_rpg_items")
}

model BandRpgPlayerProgress {
  id                   String   @id @default(cuid())
  userId               String
  currentLevelId       String?
  currentQuestId       String?
  completedObjectives  Json     @default("[]")  // [objectiveId, ...]
  completedQuests      Json     @default("[]")
  completedLevels      Json     @default("[]")
  inventory            Json     @default("[]")  // [{ itemId, quantity }]
  unlockedStoryBeats   Json     @default("[]")
  activeQuestIds       Json     @default("[]")   // Phase Z.2 — [questId, ...]
  objectiveProgress    Json     @default("{}")   // Phase Z.2 — {objectiveId: count}
  unlockedLevelSlugs   Json     @default("[]")   // Phase Z.2 — [levelSlug, ...]
  openedDoors          Json     @default("[]")   // Phase Z.3 — [doorId, ...]
  activatedSwitches    Json     @default("[]")   // Phase Z.3 — [switchId, ...]
  worldState           Json     @default("{}")   // Phase Z.3 — { key: value }
  score                Int      @default(0)
  completionPct        Float    @default(0)
  totalRuns            Int      @default(0)
  totalScore           Int      @default(0)
  totalSongsRecovered  Int      @default(0)
  correctGuessCount    Int      @default(0)
  favoriteBandId       String?
  favoriteBandName     String?
  favoriteCharacterId  String?
  favoriteCharacterName String?
  lastPlayedAt         DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentLevel BandRpgLevel? @relation(fields: [currentLevelId], references: [id], onDelete: SetNull)

  @@unique([userId])
  @@map("band_rpg_player_progress")
}

model BandRpgScore {
  id                 String   @id @default(cuid())
  userId             String?
  userName           String?
  userAvatarUrl      String?
  score              Int
  completionPct      Float    @default(0)
  fastestCompletionMs Int?
  questsCompleted    Int      @default(0)
  itemsCollected     Int      @default(0)
  levelsCleared      Int      @default(0)
  isAnonymous        Boolean  @default(false)
  bandId             String?
  bandName           String?
  characterId        String?
  characterName      String?
  songId             String?
  songTitle          String?
  guessedCorrectly   Boolean  @default(false)
  guessBonus         Int      @default(0)
  createdAt          DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("band_rpg_scores")
}

model BandRpgCollectedSong {
  id               String   @id @default(cuid())
  userId           String
  songId           String
  songTitle        String
  bandId           String
  bandName         String
  guessedCorrectly Boolean  @default(false)
  scoreEarned      Int      @default(0)
  rarity           String   @default("Common")
  recoveredAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@map("band_rpg_collected_songs")
}

model BandRpgCompletedAlbum {
  id          String   @id @default(cuid())
  userId      String
  albumId     String
  albumTitle  String
  bandId      String
  bandName    String
  songCount   Int

  completedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([userId, albumId])
  @@map("band_rpg_completed_albums")
}

model BandRpgSetlist {
  id        String   @id @default(cuid())
  userId    String
  bandId    String
  bandName  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs    BandRpgSetlistSong[]
  concerts BandRpgConcert[]

  @@map("band_rpg_setlists")
}

model BandRpgSetlistSong {
  id        String   @id @default(cuid())
  setlistId String
  songId    String
  songTitle String
  rarity    String   @default("Common")
  position  Int
  addedAt   DateTime @default(now())

  setlist BandRpgSetlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)

  @@unique([setlistId, songId])
  @@map("band_rpg_setlist_songs")
}

model BandRpgVenue {
  id                  String   @id
  name                String
  description         String
  capacity            Int
  atmosphereAffinity  Int
  aggressionAffinity  Int
  complexityAffinity  Int
  emotionAffinity     Int
  psychedelicAffinity Int
  conceptAffinity     Int
  rarityBonus         Int
  createdAt           DateTime @default(now())

  concerts   BandRpgConcert[]
  tourStops  BandRpgTourStop[]
  concertRuns ConcertRun[]
  headlinerDailyChallenges HeadlinerDailyChallenge[]

  @@map("band_rpg_venues")
}

model BandRpgConcert {
  id             String   @id @default(cuid())
  userId         String
  bandId         String
  bandName       String
  concertName    String
  setlistId      String
  venueId        String?
  encorePosition Int?
  realWorldScore Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  setlist        BandRpgSetlist            @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  venue          BandRpgVenue?             @relation(fields: [venueId], references: [id], onDelete: SetNull)
  festivalEntries BandRpgFestivalConcert[]
  tourStops       BandRpgTourStop[]

  @@map("band_rpg_concerts")
}

// ---------------------------------------------------------------------------
// Festival Builder — Phase N
// A Festival is an ordered collection of Concerts.
// ---------------------------------------------------------------------------

model BandRpgFestival {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isDream     Boolean  @default(false) // at most one per user (enforced at API level)
  visibility  String   @default("private") // public | unlisted | private
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concerts BandRpgFestivalConcert[]

  @@map("band_rpg_festivals")
}

model BandRpgFestivalConcert {
  id         String   @id @default(cuid())
  festivalId String
  concertId  String
  position   Int
  addedAt    DateTime @default(now())

  festival BandRpgFestival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  concert  BandRpgConcert  @relation(fields: [concertId], references: [id], onDelete: Cascade)

  @@unique([festivalId, concertId])
  @@map("band_rpg_festival_concerts")
}

// ---------------------------------------------------------------------------
// Audience Profile — Music Identity Framework (Phase O)
// AI-scored 10-dimension profile describing who a song/album/band appeals to.
// Scale: 0-100. Separate from the lyric spectrum (0-10) and music spectrum (0-10).
// ---------------------------------------------------------------------------

model SongAudienceProfile {
  id              String   @id @default(cuid())
  songId          String   @unique
  model           String
  progressive     Float    @default(0)   // avant-garde, non-linear, complex structures
  heavy           Float    @default(0)   // physical weight, power, sonic mass
  technical       Float    @default(0)   // instrumental skill and compositional complexity
  atmospheric     Float    @default(0)   // mood, texture, immersion, ambience
  experimental    Float    @default(0)   // boundary-pushing, unconventional, unexpected
  accessible      Float    @default(0)   // easy on first listen, familiar structures
  psychedelic     Float    @default(0)   // mind-altering, surreal, consciousness-expanding
  emotional       Float    @default(0)   // emotional depth and impact
  aggressive      Float    @default(0)   // anger, intensity, confrontational energy
  improvisational Float    @default(0)   // spontaneity, live-feel, jazz-like freedom
  rationales      Json     @default("{}") // Record<dimensionKey, string> — one rationale per dimension
  contextJson     String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("song_audience_profiles")
}

model AlbumAudienceProfile {
  id              String   @id @default(cuid())
  albumId         String   @unique
  progressive     Float    @default(0)
  heavy           Float    @default(0)
  technical       Float    @default(0)
  atmospheric     Float    @default(0)
  experimental    Float    @default(0)
  accessible      Float    @default(0)
  psychedelic     Float    @default(0)
  emotional       Float    @default(0)
  aggressive      Float    @default(0)
  improvisational Float    @default(0)
  songCount       Int      @default(0)   // number of song profiles included in the average
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@map("album_audience_profiles")
}

model BandAudienceProfile {
  id              String   @id @default(cuid())
  bandId          String   @unique
  progressive     Float    @default(0)
  heavy           Float    @default(0)
  technical       Float    @default(0)
  atmospheric     Float    @default(0)
  experimental    Float    @default(0)
  accessible      Float    @default(0)
  psychedelic     Float    @default(0)
  emotional       Float    @default(0)
  aggressive      Float    @default(0)
  improvisational Float    @default(0)
  songCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@map("band_audience_profiles")
}

// Phase V: Real World Intelligence — live performance data from Setlist.fm.
// Populated via the admin fetch-live-data endpoint. Gracefully empty until fetched.
model BandRpgSongProfile {
  id                    String    @id @default(cuid())
  songId                String    @unique
  trackRank             Float?    // relative play frequency rank (lower = more often)
  setlistFmId           String?   // Setlist.fm song identifier (reserved)
  // Phase V fields
  totalPerformances     Int       @default(0)
  performancePct        Float     @default(0)   // % of band's total shows this song appeared in
  firstPerformanceDate  DateTime?
  lastPerformanceDate   DateTime?
  yearsSincePlayed      Float?                  // computed at fetch time; stale but good enough
  distinctYears         Int       @default(0)   // distinct calendar years appeared
  rarityIndex           Float     @default(50)  // 0-100; higher = rarer
  liveStatus            String    @default("Unknown")  // Never Played | Extremely Rare | Rare | Occasional | Common | Staple | Unknown
  liveValue             Float     @default(0)   // 0-100 excitement score
  lastLiveDataFetchedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("band_rpg_song_profiles")
}

// Per-band cache of Setlist.fm fetch state.
model BandLiveDataCache {
  id                  String    @id @default(cuid())
  bandId              String    @unique
  setlistFmMbid       String?   // MusicBrainz artist ID
  setlistFmName       String?   // artist name as returned by Setlist.fm
  totalShows          Int       @default(0)
  fetchedShows        Int       @default(0)
  lastFetchedAt       DateTime?
  fetchStatus         String    @default("never") // never | in_progress | complete | failed
  errorMessage        String?

  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@map("band_live_data_caches")
}

// Raw song appearances from Setlist.fm — stored during fetch for local re-analysis.
// Allows admins to fix song matching without making new API calls.
model BandRpgRawSetlistEntry {
  id             String   @id @default(cuid())
  bandId         String
  setlistFmId    String   // Setlist.fm setlist ID (e.g. "abc123")
  eventDate      String   // "DD-MM-YYYY" as returned by Setlist.fm
  setlistFmTitle String   // raw song title exactly as Setlist.fm returned it
  isTape         Boolean  @default(false)
  matchedSongId  String?  // null = unmatched at fetch time
  // Real position data captured straight from Setlist.fm — Phase Z.17.10 schema
  // prep for a future opener/closer/encore/co-occurrence derivation (not built
  // yet). NULL on any row fetched before this field existed; never backfilled
  // or inferred — see docs/proposals/HEADLINER_DATA_FLOW.md §5, §14-15.
  setNumber      Int?     // 0-based index of this set within the show
  position       Int?     // 0-based index of this song within its set
  isEncore       Boolean? // true when Setlist.fm's own `encore` marker was present on this set

  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@index([bandId])
  @@index([bandId, setlistFmTitle])
  @@map("band_rpg_raw_setlist_entries")
}

// Admin-defined aliases mapping Setlist.fm titles to canonical BSM songs.
// When added, trigger a local re-analysis to update play counts without re-calling the API.
model BandRpgSongAlias {
  id             String   @id @default(cuid())
  bandId         String
  setlistFmTitle String   // raw title as it appears in Setlist.fm
  songId         String?  // null = explicitly ignore this title
  note           String?  // optional admin annotation
  createdAt      DateTime @default(now())

  band Band  @relation(fields: [bandId], references: [id], onDelete: Cascade)
  song Song? @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@unique([bandId, setlistFmTitle])
  @@map("band_rpg_song_aliases")
}

// ---------------------------------------------------------------------------
// Tour Builder — Phase W
// A Tour is an ordered sequence of Concerts representing a tour story.
// ---------------------------------------------------------------------------

model BandRpgTour {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  visibility  String   @default("private") // public | unlisted | private
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops BandRpgTourStop[]

  @@index([userId])
  @@map("band_rpg_tours")
}

model BandRpgTourStop {
  id          String  @id @default(cuid())
  tourId      String
  position    Int
  concertId   String
  venueId     String?
  cityName    String?
  countryName String?

  tour    BandRpgTour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  concert BandRpgConcert @relation(fields: [concertId], references: [id], onDelete: Cascade)
  venue   BandRpgVenue?  @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@unique([tourId, position])
  @@map("band_rpg_tour_stops")
}


// ---------------------------------------------------------------------------
// Phase X: Rival Events & Challenges
// A Challenge defines an objective. Attempts record each evaluation.
// Global challenges (userId = null) are seeded at boot; user-generated ones
// are created on demand via the Generate endpoint.
// ---------------------------------------------------------------------------

model BandRpgChallenge {
  id             String    @id @default(cuid())
  userId         String?
  name           String
  description    String
  type           String    // festival | tour | concert | setlist | collection | dream_festival
  difficulty     String    // easy | medium | hard | legendary
  rivalName      String?
  rivalDesc      String?
  targetAudience String?
  rewardTitle    String?
  rewardBadge    String?
  minChemistry   Float?
  minVariety     Float?
  minMomentum    Float?
  minPrestige    Float?
  minDiversity   Float?
  minDeepCut     Float?
  minFanService  Float?
  minRareSongs   Int?
  minAlbums      Int?
  minStopCount   Int?
  isGenerated    Boolean   @default(false)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  user     User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts BandRpgChallengeAttempt[]

  @@index([userId])
  @@map("band_rpg_challenges")
}

model BandRpgChallengeAttempt {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  entityType  String   // festival | tour | concert | setlist | collection
  entityId    String   @default("")
  entityName  String
  achieved    Boolean  @default(false)
  metricScore Float    @default(0)
  tier        String?  // bronze | silver | gold | platinum
  completedAt DateTime @default(now())

  challenge BandRpgChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([userId])
  @@map("band_rpg_challenge_attempts")
}

// ---------------------------------------------------------------------------
// Phase X.5: Curator Progression
// A single profile per user tracking XP, level, titles, and earned badges.
// Stats are computed live from other tables; only persistent unlock state lives here.
// ---------------------------------------------------------------------------

model BandRpgCuratorProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  xp                    Int       @default(0)
  currentTitle          String?
  titlesUnlocked        String[]  @default([])  // challenge-earned titles
  badgesUnlocked        String[]  @default([])  // badge keys
  selectedCharacterId   String?
  selectedCharacterName String?
  visibility            String    @default("public") // public | unlisted | private
  firstRecoveryDate     DateTime?
  lastActiveDate        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("band_rpg_curator_profiles")
}

// ---------------------------------------------------------------------------
// Phase Y.3: Community Appreciation
// ---------------------------------------------------------------------------

model BandRpgFavorite {
  id         String   @id @default(cuid())
  userId     String
  kind       String   // 'favorite' | 'saved'
  entityType String   // 'curator' | 'festival' | 'tour'
  entityId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, entityType, entityId])
  @@index([entityType, entityId])
  @@map("band_rpg_favorites")
}

model BandRpgCuratorFollow {
  id         String   @id @default(cuid())
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  follower User @relation("BandRpgFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("BandRpgFollowee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId])
  @@map("band_rpg_curator_follows")
}

// ── Phase Z.4: Adventure Scoping ──────────────────────────────────────────────

model BandRpgAdventure {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?
  version          Int      @default(1)
  isPublished      Boolean  @default(false)
  featured         Boolean  @default(false)
  coverImageUrl    String?
  authorName       String?
  difficulty       String?  // beginner | intermediate | advanced | expert
  estimatedPlaytime Int?    // minutes
  tags             Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  levels   BandRpgLevel[]
  quests   BandRpgQuest[]
  arcs     BandRpgStoryArc[]
  items    BandRpgItem[]                @relation("AdventureItems")
  progress BandRpgAdventureProgress[]

  @@map("band_rpg_adventures")
}

// ── Phase Z.5: Adventure Progress ─────────────────────────────────────────────

model BandRpgAdventureProgress {
  id               String    @id @default(cuid())
  userId           String
  adventureId      String
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  lastPlayedAt     DateTime  @default(now())
  completionPct    Float     @default(0)
  questsCompleted  Int       @default(0)
  itemsCollected   Int       @default(0)
  levelsDiscovered Json      @default("[]")
  isCompleted      Boolean   @default(false)

  user      User             @relation("UserAdventureProgress", fields: [userId], references: [id], onDelete: Cascade)
  adventure BandRpgAdventure @relation(fields: [adventureId], references: [id], onDelete: Cascade)

  @@unique([userId, adventureId])
  @@map("band_rpg_adventure_progress")
}

// ── Phase Z.17.9: Headliner ───────────────────────────────────────────────────
// Player-owned concert-building game. Deliberately separate from every Band RPG
// model above — no shared tables, no shared progression. See
// docs/proposals/CONCERT_ARCHITECT.md and HEADLINER_DATA_FLOW.md.

model ConcertRun {
  id            String    @id @default(cuid())
  userId        String
  mode          String    // quick | daily | campaign | historical
  bandId        String
  venueId       String?
  campaignStageKey String? // StageKey (campaignStages.ts) — set only when mode = "campaign"
  dailyChallengeId String? // set only when mode = "daily"
  engineVersion String    @default("HEADLINER_ENGINE_V1") // concertEngine.ts's ENGINE_VERSION at run creation
  difficulty    String    @default("normal")
  seed          String
  status        String    @default("in_progress") // in_progress | completed | abandoned
  picksJson     Json      @default("[]")   // ordered array of songId picks made so far
  stateJson     Json                        // full engine snapshot: show bundle + running totals (see concertDataService)
  reportJson    Json?                       // final report, written once status = completed
  overallScore  Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  band  Band          @relation(fields: [bandId], references: [id], onDelete: Cascade)
  venue BandRpgVenue? @relation(fields: [venueId], references: [id], onDelete: SetNull)
  dailyChallenge HeadlinerDailyChallenge? @relation(fields: [dailyChallengeId], references: [id], onDelete: SetNull)

  campaignShowResult HeadlinerCampaignShowResult?
  dailyResult        HeadlinerDailyResult?

  @@index([userId])
  @@index([bandId, overallScore])
  @@index([dailyChallengeId])
  @@map("headliner_concert_runs")
}

// ── Phase Z.17.10: Headliner Campaign ─────────────────────────────────────────
// Player-owned progression through the Campaign stage ladder (campaignStages.ts).
// Candidate songs for every Campaign run come ONLY from BandRpgCollectedSong —
// this progress model tracks the ladder itself, never a second song inventory.

model HeadlinerCampaignProgress {
  id                   String   @id @default(cuid())
  userId               String
  bandId               String
  currentStage         String   @default("rehearsal_room") // StageKey last played
  unlockedStage        String   @default("rehearsal_room") // StageKey furthest reachable
  totalShowsCompleted  Int      @default(0)
  bestScore            Int?
  totalAudienceReached Int      @default(0)
  starsEarned          Int      @default(0) // sum of best-stars-per-stage; recomputed on every finalize, not incremented
  tutorialCompleted    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user        User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  band        Band                          @relation(fields: [bandId], references: [id], onDelete: Cascade)
  showResults HeadlinerCampaignShowResult[]

  @@unique([userId, bandId])
  @@map("headliner_campaign_progress")
}

model HeadlinerCampaignShowResult {
  id           String   @id @default(cuid())
  progressId   String
  stageKey     String
  concertRunId String   @unique
  score        Int
  stars        Int
  firstClear   Boolean  @default(false)
  completedAt  DateTime @default(now())

  progress   HeadlinerCampaignProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  concertRun ConcertRun                @relation(fields: [concertRunId], references: [id], onDelete: Cascade)

  @@index([progressId, stageKey])
  @@map("headliner_campaign_show_results")
}

// ── Phase Z.17.11: Headliner Daily Challenge ──────────────────────────────────
// One shared, frozen concert puzzle per UTC calendar date. bundleSnapshotJson
// freezes the full ShowBundle (songs, target spectrum, venue, rules) at
// creation time so later canonical data changes can never reshuffle a
// challenge that's already live — see dailyChallengeService.ts.

model HeadlinerDailyChallenge {
  id                 String   @id @default(cuid())
  challengeDate      String   // "YYYY-MM-DD", UTC
  version            Int      @default(1) // DAILY_CHALLENGE_VERSION — selection/format version
  seed               String
  bandId             String
  bandName           String   // denormalized snapshot — historical display never changes if the band is later renamed
  venueId            String?
  contextKey         String
  difficulty         String   @default("normal")
  engineVersion      String   // concertEngine.ts's ENGINE_VERSION at creation
  bundleSnapshotJson Json     // frozen ShowBundle — never re-derived from live data after creation
  createdAt          DateTime @default(now())

  band  Band          @relation(fields: [bandId], references: [id], onDelete: Cascade)
  venue BandRpgVenue? @relation(fields: [venueId], references: [id], onDelete: SetNull)

  runs    ConcertRun[]
  results HeadlinerDailyResult[]

  @@unique([challengeDate, version])
  @@map("headliner_daily_challenges")
}

model HeadlinerDailyResult {
  id              String   @id @default(cuid())
  challengeId     String
  userId          String
  concertRunId    String   @unique
  score           Int      // report.overallScore — the authoritative, server-computed ranking value
  finalAttendance Float    // report.metrics.audienceRetention
  satisfaction    Float    // unweighted mean of all 10 report metrics — distinct from the weighted `score`
  authenticity    Float    // report.metrics.authenticity
  spectrumMatch   Float    // report.metrics.spectrumMatch
  pacing          Float    // report.metrics.paceDiscipline
  encoreQuality   Float    // report.metrics.encoreQuality
  completedAt     DateTime @default(now())

  challenge  HeadlinerDailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concertRun ConcertRun              @relation(fields: [concertRunId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId, score])
  @@map("headliner_daily_results")
}
