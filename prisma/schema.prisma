// Band Spectrum Mapper — Prisma Schema
// Source of truth for all database entities.
// Use `prisma migrate dev --name <name>` for all schema changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core library entities
// ---------------------------------------------------------------------------

model Band {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  albums  Album[]
  songs   Song[]
  scores  SongAxisScore[]

  @@map("bands")
}

model Album {
  id          String    @id @default(cuid())
  bandId      String
  title       String
  slug        String
  year        Int?
  releaseDate DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  band  Band   @relation(fields: [bandId], references: [id], onDelete: Cascade)
  songs Song[]

  @@unique([bandId, slug])
  @@map("albums")
}

model Song {
  id              String   @id @default(cuid())
  bandId          String
  albumId         String?
  title           String
  slug            String
  trackNumber     Int?
  durationSeconds Int?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  band   Band    @relation(fields: [bandId], references: [id], onDelete: Cascade)
  album  Album?  @relation(fields: [albumId], references: [id], onDelete: SetNull)

  lyrics          Lyric[]
  score           SongAxisScore?
  songTags        SongTag[]
  ratings         UserSongRating[]
  comments        SongComment[]
  aiAnalysis      SongAiAnalysis?
  aiSpectrum      SongAiSpectrum?
  research        SongResearch?
  contextAnalysis SongContextAnalysis?
  genreRatings    SongGenreRating[]
  analysisRatings SongAnalysisRating[]
  aiGenreSpectrum SongAiGenreSpectrum?

  @@unique([bandId, slug])
  @@map("songs")
}

// ---------------------------------------------------------------------------
// Lyrics — separate from songs for editability, versioning, and provenance
// ---------------------------------------------------------------------------

model Lyric {
  id          String      @id @default(cuid())
  songId      String
  sourceType  SourceType
  sourceLabel String?
  text        String
  isPrimary   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  song      Song            @relation(fields: [songId], references: [id], onDelete: Cascade)
  revisions LyricRevision[]

  @@map("lyrics")
}

enum SourceType {
  manual
  paste
  file_import
  licensed
  user_provided

  @@map("source_type")
}

model LyricRevision {
  id           String   @id @default(cuid())
  lyricId      String
  previousText String
  newText      String
  changeNote   String?
  createdAt    DateTime @default(now())

  lyric Lyric @relation(fields: [lyricId], references: [id], onDelete: Cascade)

  @@map("lyric_revisions")
}

// ---------------------------------------------------------------------------
// Spectrum scoring — 6 axes, kept separate from song for schema flexibility
// ---------------------------------------------------------------------------

model SongAxisScore {
  id          String   @id @default(cuid())
  songId      String   @unique
  bandId      String
  aggression  Float    @default(0)
  complexity  Float    @default(0)
  atmosphere  Float    @default(0)
  emotion     Float    @default(0)
  psychedelic Float    @default(0)
  concept     Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@map("song_axis_scores")
}

// ---------------------------------------------------------------------------
// Tags — reusable labels for songs
// ---------------------------------------------------------------------------

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  songTags SongTag[]

  @@map("tags")
}

model SongTag {
  id     String @id @default(cuid())
  songId String
  tagId  String

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([songId, tagId])
  @@map("song_tags")
}

// ---------------------------------------------------------------------------
// Analysis configuration
// ---------------------------------------------------------------------------

model CustomStopword {
  id        String   @id @default(cuid())
  word      String   @unique
  createdAt DateTime @default(now())

  @@map("custom_stopwords")
}

// ---------------------------------------------------------------------------
// Import tracking
// ---------------------------------------------------------------------------

model Import {
  id         String       @id @default(cuid())
  importType String
  filename   String
  mimeType   String
  status     ImportStatus @default(pending)
  summary    Json?
  createdAt  DateTime     @default(now())

  @@map("imports")
}

enum ImportStatus {
  pending
  processing
  success
  partial
  failed

  @@map("import_status")
}

// ---------------------------------------------------------------------------
// Saved comparisons
// ---------------------------------------------------------------------------

model Comparison {
  id         String   @id @default(cuid())
  name       String
  configJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("comparisons")
}

// ---------------------------------------------------------------------------
// AI analysis cache — one row per song, regenerated on demand
// ---------------------------------------------------------------------------

model SongAiSpectrum {
  id          String   @id @default(cuid())
  songId      String   @unique
  model       String
  aggression  Float
  complexity  Float
  atmosphere  Float
  emotion     Float
  psychedelic Float
  concept     Float
  rationale   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("song_ai_spectra")
}

model SongAiAnalysis {
  id                String   @id @default(cuid())
  songId            String   @unique
  model             String
  themes            Json
  emotionalRegister String
  conceptualDepth   String
  notableElements   Json
  rawResponse       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("song_ai_analyses")
}

// ---------------------------------------------------------------------------
// Wikipedia research cache — one row per song
// ---------------------------------------------------------------------------

model SongResearch {
  id         String   @id @default(cuid())
  songId     String   @unique
  model      String
  summary    String
  musicStyle String?
  sources    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("song_research")
}

// ---------------------------------------------------------------------------
// Deep context synthesis — combines lyrics, research, scores, ratings
// ---------------------------------------------------------------------------

model SongContextAnalysis {
  id                    String   @id @default(cuid())
  songId                String   @unique
  model                 String
  titleSignificance     String
  historicalContext     String
  lyricalInterpretation String
  thematicSynthesis     String
  overallNarrative      String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("song_context_analyses")
}

// ---------------------------------------------------------------------------
// Users — created on first Google login
// ---------------------------------------------------------------------------

model User {
  id                  String   @id @default(cuid())
  googleId            String   @unique
  email               String   @unique
  name                String?
  avatarUrl           String?
  isAdmin             Boolean  @default(false)
  isCommunityExcluded Boolean  @default(false)
  isActive            Boolean  @default(true)
  lookupTokens        Int      @default(3)
  tokensLastRefreshed DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  ratings              UserSongRating[]
  comments             SongComment[]
  genreRatings         SongGenreRating[]
  analysisRatings      SongAnalysisRating[]
  contributions        PendingContribution[] @relation("ContributionAuthor")
  contributionReviews  PendingContribution[] @relation("ContributionReviewer")

  @@map("users")
}

// ---------------------------------------------------------------------------
// User song ratings — one row per (user, song), integers 0-10
// ---------------------------------------------------------------------------

model UserSongRating {
  id          String   @id @default(cuid())
  userId      String
  songId      String
  aggression  Int      @default(0)
  complexity  Int      @default(0)
  atmosphere  Int      @default(0)
  emotion     Int      @default(0)
  psychedelic Int      @default(0)
  concept     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@map("user_song_ratings")
}

// ---------------------------------------------------------------------------
// Song comments — open to any authenticated user, visible to all
// ---------------------------------------------------------------------------

model SongComment {
  id        String   @id @default(cuid())
  songId    String
  userId    String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("song_comments")
}

// ---------------------------------------------------------------------------
// App icons — favicon and PWA icons stored as base64 PNG data URLs
// ---------------------------------------------------------------------------

model AppIcon {
  id        String   @id @default(cuid())
  size      Int
  dataUrl   String
  updatedAt DateTime @updatedAt

  @@unique([size])
  @@map("app_icons")
}

// ---------------------------------------------------------------------------
// Genre perspective ratings — how a song lands for fans of different genres
// One row per (user, song, perspective). Perspective is a short string id.
// ---------------------------------------------------------------------------

model SongGenreRating {
  id          String   @id @default(cuid())
  songId      String
  userId      String
  perspective String   // e.g. 'metal', 'rock', 'pop', 'hiphop', 'electronic', 'folk'
  score       Int      // 1–10
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, songId, perspective])
  @@map("song_genre_ratings")
}

// ---------------------------------------------------------------------------
// AI analysis ratings — did the user find the AI analysis helpful?
// One row per (user, song).
// ---------------------------------------------------------------------------

model SongAnalysisRating {
  id        String   @id @default(cuid())
  songId    String
  userId    String
  helpful   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@map("song_analysis_ratings")
}

// ---------------------------------------------------------------------------
// AI-generated genre accessibility spectrum — how the song lands for fans of
// each genre. One row per song, cached. 1–10 per genre.
// ---------------------------------------------------------------------------

model SongAiGenreSpectrum {
  id          String   @id @default(cuid())
  songId      String   @unique
  model       String
  metal       Float
  rock        Float
  pop         Float
  hiphop      Float
  electronic  Float
  folk        Float
  rationale   String   // brief AI explanation of the genre spread
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("song_ai_genre_spectrums")
}

// ---------------------------------------------------------------------------
// Pending library contributions — users request bands/albums via MusicBrainz.
// Admin reviews and approves (auto-imports) or rejects.
// ---------------------------------------------------------------------------

model PendingContribution {
  id           String    @id @default(cuid())
  userId       String
  artistName   String
  artistMbId   String
  albumCount   Int       @default(0)
  data         Json      // discography payload in discographyImportService format
  status       String    @default("pending") // pending | approved | rejected
  adminNote    String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  user     User  @relation("ContributionAuthor",   fields: [userId],       references: [id], onDelete: Cascade)
  reviewer User? @relation("ContributionReviewer", fields: [reviewedById], references: [id])

  @@map("pending_contributions")
}
