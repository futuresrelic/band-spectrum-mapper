// Band Spectrum Mapper — Prisma Schema
// Source of truth for all database entities.
// Use `prisma migrate dev --name <name>` for all schema changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core library entities
// ---------------------------------------------------------------------------

model Band {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  albums          Album[]
  songs           Song[]
  scores          SongAxisScore[]
  contextAnalysis BandContextAnalysis?
  audienceProfile BandAudienceProfile?
  socialPosts     SocialPost[]
  contentSeries   ContentSeries[]
  members         BandMember[]
  characterSkins  PlatformerCharacterSkin[]
  liveDataCache      BandLiveDataCache?
  rawSetlistEntries  BandRpgRawSetlistEntry[]
  bandRpgSongAliases BandRpgSongAlias[]
  concertRuns        ConcertRun[]
  headlinerCampaignProgress HeadlinerCampaignProgress[]
  headlinerDailyChallenges  HeadlinerDailyChallenge[]

  @@map("bands")
}

enum AlbumType {
  studio
  ep
  live
  compilation
  bootleg
  single
  demo
  lp
  remix
  mixtape
  boxset
  soundtrack
  acoustic
  instrumental
}

model Album {
  id          String     @id @default(cuid())
  bandId      String
  title       String
  slug        String
  year        Int?
  releaseDate DateTime?
  artworkUrl  String?
  notes       String?
  albumType   AlbumType?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  band            Band   @relation(fields: [bandId], references: [id], onDelete: Cascade)
  songs           Song[]
  contextAnalysis AlbumContextAnalysis?
  audienceProfile AlbumAudienceProfile?
  socialPosts     SocialPost[]
  bandRpgCompletedAlbums BandRpgCompletedAlbum[]

  @@unique([bandId, slug])
  @@map("albums")
}

// ---------------------------------------------------------------------------
// Song rarity — drives weighted discovery in Band RPG
// ---------------------------------------------------------------------------

enum SongRarity {
  Common
  Uncommon
  Rare
  Legendary
  Mythic
}

// Track Classification (Phase Z.17.15): what a track IS. Kept separate
// from eligibility (WHERE it may be selected) — see the eligible* flags
// below on Song.
enum TrackType {
  Song       // Normal musical track. Default for imported tracks.
  Interlude  // Intro, outro, transition, ambience, soundscape.
  Spoken     // Spoken word, comedy, narration, skits, poems.
  Cover      // Song written by another artist.
  Special    // Hidden tracks, bonus tracks, demos, alternate versions.
}

model Song {
  id              String   @id @default(cuid())
  bandId          String
  albumId         String?
  title           String
  slug            String
  trackNumber     Int?
  durationSeconds Int?
  notes           String?
  isInstrumental  Boolean   @default(false)
  isRemix         Boolean   @default(false)
  remixOfSongId   String?
  sourceSongId    String?
  noLyricsAt      DateTime?
  rarity          SongRarity @default(Common)
  trackType              TrackType @default(Song)
  eligibleHeadliner      Boolean   @default(true)
  eligibleDailyChallenge Boolean   @default(true)
  eligibleTrivia         Boolean   @default(true)
  eligibleAiSetlists     Boolean   @default(true)
  eligibleDiscovery      Boolean   @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  band      Band    @relation(fields: [bandId], references: [id], onDelete: Cascade)
  album     Album?  @relation(fields: [albumId], references: [id], onDelete: SetNull)
  remixOf   Song?   @relation("SongRemixes",      fields: [remixOfSongId], references: [id], onDelete: SetNull)
  remixes   Song[]  @relation("SongRemixes")
  sourceSong  Song?   @relation("SongDerivations", fields: [sourceSongId],  references: [id], onDelete: SetNull)
  derivations Song[]  @relation("SongDerivations")

  lyrics          Lyric[]
  score           SongAxisScore?
  songTags        SongTag[]
  ratings         UserSongRating[]
  musicRatings    UserMusicRating[]
  comments        SongComment[]
  aiAnalysis      SongAiAnalysis?
  aiSpectrum      SongAiSpectrum?
  research        SongResearch?
  contextAnalysis SongContextAnalysis?
  genreRatings    SongGenreRating[]
  analysisRatings SongAnalysisRating[]
  aiGenreSpectrum SongAiGenreSpectrum?
  musicScore      SongMusicScore?
  audienceProfile SongAudienceProfile?
  themeScores        SongThemeScore[]
  spectrumAnalyses   SongSpectrumAnalysis[]
  socialPosts        SocialPost[]
  tagProposals       TagProposal[]
  bandRpgProfile     BandRpgSongProfile?
  bandRpgAliases     BandRpgSongAlias[]
  media              SongMedia?

  @@unique([bandId, slug])
  @@map("songs")

  playlistSongs PlaylistSong[]
}

// ---------------------------------------------------------------------------
// Lyrics — separate from songs for editability, versioning, and provenance
// ---------------------------------------------------------------------------

model Lyric {
  id          String      @id @default(cuid())
  songId      String
  sourceType  SourceType
  sourceLabel String?
  text        String
  isPrimary   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  song      Song            @relation(fields: [songId], references: [id], onDelete: Cascade)
  revisions LyricRevision[]

  @@map("lyrics")
}

enum SourceType {
  manual
  paste
  file_import
  licensed
  user_provided
  ai_recall

  @@map("source_type")
}

model LyricRevision {
  id           String   @id @default(cuid())
  lyricId      String
  previousText String
  newText      String
  changeNote   String?
  createdAt    DateTime @default(now())

  lyric Lyric @relation(fields: [lyricId], references: [id], onDelete: Cascade)

  @@map("lyric_revisions")
}

// ---------------------------------------------------------------------------
// Spectrum scoring — 6 axes, kept separate from song for schema flexibility
// ---------------------------------------------------------------------------

model SongAxisScore {
  id          String   @id @default(cuid())
  songId      String   @unique
  bandId      String
  aggression  Float    @default(0)
  complexity  Float    @default(0)
  atmosphere  Float    @default(0)
  emotion     Float    @default(0)
  psychedelic Float    @default(0)
  concept     Float    @default(0)
  notes       String?
  // Provenance — null on rows written before this field existed.
  // 'ai' | 'manual' | 'import' | 'audio'
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@map("song_axis_scores")
}

// ---------------------------------------------------------------------------
// Tags — reusable labels for songs
// ---------------------------------------------------------------------------

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  songTags SongTag[]

  @@map("tags")
}

model SongTag {
  id          String  @id @default(cuid())
  songId      String
  tagId       String
  description String?

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([songId, tagId])
  @@map("song_tags")
}

// ---------------------------------------------------------------------------
// Analysis configuration
// ---------------------------------------------------------------------------

model CustomStopword {
  id        String   @id @default(cuid())
  word      String   @unique
  createdAt DateTime @default(now())

  @@map("custom_stopwords")
}

// ---------------------------------------------------------------------------
// Import tracking
// ---------------------------------------------------------------------------

model Import {
  id         String       @id @default(cuid())
  importType String
  filename   String
  mimeType   String
  status     ImportStatus @default(pending)
  summary    Json?
  createdAt  DateTime     @default(now())

  @@map("imports")
}

enum ImportStatus {
  pending
  processing
  success
  partial
  failed

  @@map("import_status")
}

// ---------------------------------------------------------------------------
// Saved comparisons
// ---------------------------------------------------------------------------

model Comparison {
  id         String   @id @default(cuid())
  name       String
  configJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("comparisons")
}

// ---------------------------------------------------------------------------
// AI analysis cache — one row per song, regenerated on demand
// ---------------------------------------------------------------------------

model SongAiSpectrum {
  id                String   @id @default(cuid())
  songId            String   @unique
  model             String
  aggression        Float
  complexity        Float
  atmosphere        Float
  emotion           Float
  psychedelic       Float
  concept           Float
  rationale         String
  contextInferred   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("song_ai_spectra")
}

model SongAiAnalysis {
  id                String   @id @default(cuid())
  songId            String   @unique
  model             String
  themes            Json
  emotionalRegister String
  conceptualDepth   String
  notableElements   Json
  rawResponse       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("song_ai_analyses")
}

// ---------------------------------------------------------------------------
// Wikipedia research cache — one row per song
// ---------------------------------------------------------------------------

model SongResearch {
  id         String   @id @default(cuid())
  songId     String   @unique
  model      String
  summary    String
  musicStyle String?
  sources    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("song_research")
}

// ---------------------------------------------------------------------------
// Deep context synthesis — combines lyrics, research, scores, ratings
// ---------------------------------------------------------------------------

model SongContextAnalysis {
  id                    String   @id @default(cuid())
  songId                String   @unique
  model                 String
  titleSignificance     String
  historicalContext     String
  lyricalInterpretation String
  thematicSynthesis     String
  overallNarrative      String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("song_context_analyses")
}

model AlbumContextAnalysis {
  id                String   @id @default(cuid())
  albumId           String   @unique
  model             String
  overallNarrative  String
  thematicSynthesis String
  artisticContext   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@map("album_context_analyses")
}

model BandContextAnalysis {
  id                String   @id @default(cuid())
  bandId            String   @unique
  model             String
  overallNarrative  String
  thematicSynthesis String
  artisticEvolution String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@map("band_context_analyses")
}

// ---------------------------------------------------------------------------
// Users — created on first Google login
// ---------------------------------------------------------------------------

model User {
  id                  String   @id @default(cuid())
  googleId            String   @unique
  email               String   @unique
  name                String?
  username            String?  @unique
  avatarUrl           String?
  isAdmin             Boolean  @default(false)
  isCommunityExcluded Boolean  @default(false)
  isActive            Boolean  @default(true)
  lookupTokens        Int      @default(3)
  tokensLastRefreshed DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  ratings              UserSongRating[]
  musicRatings         UserMusicRating[]
  comments             SongComment[]
  genreRatings         SongGenreRating[]
  analysisRatings      SongAnalysisRating[]
  contributions        PendingContribution[] @relation("ContributionAuthor")
  contributionReviews  PendingContribution[] @relation("ContributionReviewer")
  gameScores           GameScore[]
  wordHuntScores       WordHuntScore[]
  lyricChainScores     LyricChainScore[]
  lyricCompleteScores  LyricCompleteScore[]
  band2048Scores       Band2048Score[]
  crosswordScores      CrosswordScore[]
  wordSearchScores     WordSearchScore[]
  recordCatcherScores  RecordCatcherScore[]
  lyricDissectionScores LyricDissectionScore[]
  timelineScores        TimelineScore[]
  spectrumGuesserScores SpectrumGuesserScore[]
  lyricMatchScores      LyricMatchScore[]
  graphHuntScores       GraphHuntScore[]
  lyricDuelScores       LyricDuelScore[]
  platformerScores      PlatformerScore[]
  submittedSkins        PlatformerCharacterSkin[] @relation("SkinSubmitter")
  playlists             Playlist[]
  nodeSequences        UserNodeSequence[]
  cinemaData           UserCinemaData?
  tagProposals         TagProposal[]
  tagVotes             TagVote[]
  bandRpgProgress      BandRpgPlayerProgress?
  bandRpgScores        BandRpgScore[]
  bandRpgCollection    BandRpgCollectedSong[]
  bandRpgCompletedAlbums BandRpgCompletedAlbum[]
  bandRpgSetlists      BandRpgSetlist[]
  bandRpgConcerts      BandRpgConcert[]
  bandRpgFestivals     BandRpgFestival[]
  bandRpgTours             BandRpgTour[]
  bandRpgChallenges        BandRpgChallenge[]
  bandRpgChallengeAttempts BandRpgChallengeAttempt[]
  bandRpgCuratorProfile    BandRpgCuratorProfile?
  bandRpgFavorites     BandRpgFavorite[]
  bandRpgFollowing         BandRpgCuratorFollow[]       @relation("BandRpgFollower")
  bandRpgFollowers         BandRpgCuratorFollow[]       @relation("BandRpgFollowee")
  bandRpgAdventureProgress BandRpgAdventureProgress[]   @relation("UserAdventureProgress")
  concertRuns              ConcertRun[]
  headlinerCampaignProgress HeadlinerCampaignProgress[]
  headlinerDailyResults     HeadlinerDailyResult[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// User Cinema persistence — presets, snapshots, keyframes, node overrides
// One row per admin user; each column is a JSON blob.
// ---------------------------------------------------------------------------

model UserCinemaData {
  id                String   @id @default(cuid())
  userId            String   @unique
  presetsJson       String   @default("[]")  // JSON: UserPreset[]
  snapshotsJson     String   @default("[]")  // JSON: ConfigSnapshot[]
  directorKfsJson   String   @default("[]")  // JSON: CinemaKeyframe[]
  sceneKfsJson      String   @default("{}")  // JSON: Record<string, CinemaKeyframe[]>
  nodeOverridesJson String   @default("{}")  // JSON: Record<string, NodeOverride>
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_cinema_data")
}

// ---------------------------------------------------------------------------
// User-saved Cinema node sequences
// ---------------------------------------------------------------------------

model UserNodeSequence {
  id        String   @id @default(cuid())
  userId    String
  name      String
  stepsJson String   // JSON-serialised TourStep[]
  isPublic  Boolean  @default(false) // admin can publish for all users to play
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPublic])
  @@map("user_node_sequences")
}

// ---------------------------------------------------------------------------
// Community tag proposals — user-submitted tag candidates with voting
// Auto-promoted to SongTag when net vote score reaches threshold (default 2)
// ---------------------------------------------------------------------------

model TagProposal {
  id        String    @id @default(cuid())
  songId    String
  tagName   String    // display name (lowercase, trimmed)
  slug      String    // URL-safe key
  userId    String
  status    String    @default("pending") // pending | approved | rejected
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  song  Song       @relation(fields: [songId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes TagVote[]

  @@unique([songId, slug])
  @@index([songId])
  @@map("tag_proposals")
}

model TagVote {
  id         String      @id @default(cuid())
  proposalId String
  userId     String
  vote       Int         // +1 upvote, -1 downvote
  createdAt  DateTime    @default(now())

  proposal TagProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([proposalId, userId])
  @@map("tag_votes")
}

// ---------------------------------------------------------------------------
// User song ratings — one row per (user, song), integers 0-10
// ---------------------------------------------------------------------------

model UserSongRating {
  id          String   @id @default(cuid())
  userId      String
  songId      String
  aggression  Int      @default(0)
  complexity  Int      @default(0)
  atmosphere  Int      @default(0)
  emotion     Int      @default(0)
  psychedelic Int      @default(0)
  concept     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@map("user_song_ratings")
}

// ---------------------------------------------------------------------------
// User music structure ratings — one row per (user, song), integers 0-10
// Parallel to UserSongRating but for musical characteristics.
// ---------------------------------------------------------------------------

model UserMusicRating {
  id                   String   @id @default(cuid())
  userId               String
  songId               String
  rhythmicComplexity   Int      @default(5)
  harmonicDepth        Int      @default(5)
  structuralComplexity Int      @default(5)
  sonicDensity         Int      @default(5)
  tempoEnergy          Int      @default(5)
  tonalDarkness        Int      @default(5)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@map("user_music_ratings")
}

// ---------------------------------------------------------------------------
// Song comments — open to any authenticated user, visible to all
// ---------------------------------------------------------------------------

model SongComment {
  id        String   @id @default(cuid())
  songId    String
  userId    String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("song_comments")
}

// ---------------------------------------------------------------------------
// Song media — the official YouTube video for a song. Admin-curated only;
// never arbitrary iframe URLs. Soft-delete via status='removed' (row is
// kept, not deleted) so "removed deliberately" stays distinct from "never
// had one" — Phase Z.17.6.
// ---------------------------------------------------------------------------

model SongMedia {
  id             String   @id @default(cuid())
  songId         String   @unique
  youtubeVideoId String
  sourceUrl      String
  title          String?
  // available | needs_review | broken | private | removed
  status         String   @default("available")
  addedBy        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("song_media")
}

// ---------------------------------------------------------------------------
// App icons — favicon and PWA icons stored as base64 PNG data URLs
// ---------------------------------------------------------------------------

model AppIcon {
  id        String   @id @default(cuid())
  size      Int
  dataUrl   String
  updatedAt DateTime @updatedAt

  @@unique([size])
  @@map("app_icons")
}

// ---------------------------------------------------------------------------
// Genre perspective ratings — how a song lands for fans of different genres
// One row per (user, song, perspective). Perspective is a short string id.
// ---------------------------------------------------------------------------

model SongGenreRating {
  id          String   @id @default(cuid())
  songId      String
  userId      String
  perspective String   // e.g. 'metal', 'rock', 'pop', 'hiphop', 'electronic', 'folk'
  score       Int      // 1–10
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, songId, perspective])
  @@map("song_genre_ratings")
}

// ---------------------------------------------------------------------------
// AI analysis ratings — did the user find the AI analysis helpful?
// One row per (user, song).
// ---------------------------------------------------------------------------

model SongAnalysisRating {
  id        String   @id @default(cuid())
  songId    String
  userId    String
  helpful   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@map("song_analysis_ratings")
}

// ---------------------------------------------------------------------------
// AI-generated genre accessibility spectrum — how the song lands for fans of
// each genre. One row per song, cached. 1–10 per genre.
// ---------------------------------------------------------------------------

model SongAiGenreSpectrum {
  id          String   @id @default(cuid())
  songId      String   @unique
  model       String
  metal       Float
  rock        Float
  pop         Float
  hiphop      Float
  electronic  Float
  folk        Float
  rationale   String   // brief AI explanation of the genre spread
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("song_ai_genre_spectrums")
}

// ---------------------------------------------------------------------------
// Philosophical / thematic analysis — weighted scores per song per theme.
// One row per (song, themeSlug). themeSlug keys into THEME_CATEGORIES constant.
// ---------------------------------------------------------------------------

model SongThemeScore {
  id        String   @id @default(cuid())
  songId    String
  themeSlug String   // keys into packages/shared THEME_CATEGORIES
  score     Float    // 0.0 – 1.0
  evidence  String?  // direct lyric quote or rationale, ≤500 chars
  model     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, themeSlug])
  @@map("song_theme_scores")
}

// ---------------------------------------------------------------------------
// Admin knowledge entries — curator context injected into AI analysis prompts.
// Admins write structured knowledge (e.g. "The Teachings of Tool") and the
// system includes it when generating analysis for the relevant scope.
// ---------------------------------------------------------------------------

model AdminKnowledgeEntry {
  id          String   @id @default(cuid())
  title       String
  content     String   // free-form text / markdown, injected into AI prompts
  scope       String   @default("global") // "global" | "band" | "song"
  scopeId     String?  // bandId or songId when scope != "global"
  tags        Json     @default("[]")     // string[] — theme slugs or free labels
  images      Json     @default("[]")     // KnowledgeImage[] — { url, caption, creditWho, creditPlatform }
  isActive    Boolean  @default(true)
  // Entry type — controls how this entry is framed in the AI context
  entryType   String   @default("knowledge")  // "knowledge" | "social_influence"
  // Social influence provenance — where the community signal came from
  sourceLabel String?  // e.g. "Reddit r/ToolBand", "YouTube comments", "Facebook fan group"
  sourceUrl   String?  // optional URL to original discussion
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("admin_knowledge_entries")
}

// ---------------------------------------------------------------------------
// Pending library contributions — users request bands/albums via MusicBrainz.
// Admin reviews and approves (auto-imports) or rejects.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Song Spectrum Analyzer — standalone audio analysis results
// Created by the /song-spectrum module. Optionally linked to a library song.
// ---------------------------------------------------------------------------

model SongSpectrumAnalysis {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  songTitle      String
  artistName     String
  youtubeUrl     String?
  ytMetadata     Json?    // YouTubeMetadata | null
  audioFileName  String?
  audioAnalysis  Json?    // AudioAnalysisResult | null — from Python worker
  scores         Json     @default("{}")  // Record<ScoreAxis, number>
  scoreBreakdown Json     @default("{}")  // Record<ScoreAxis, ScoreAxisDetail>
  songId         String?
  song           Song?    @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@map("song_spectrum_analyses")
}

model PendingContribution {
  id           String    @id @default(cuid())
  userId       String
  artistName   String
  artistMbId   String
  albumCount   Int       @default(0)
  data         Json      // discography payload in discographyImportService format
  status       String    @default("pending") // pending | approved | rejected
  adminNote    String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  user     User  @relation("ContributionAuthor",   fields: [userId],       references: [id], onDelete: Cascade)
  reviewer User? @relation("ContributionReviewer", fields: [reviewedById], references: [id])

  @@map("pending_contributions")
}

// ---------------------------------------------------------------------------
// Game scores — saved at end of each Album Art Quiz session
// ---------------------------------------------------------------------------

model GameScore {
  id        String   @id @default(cuid())
  userId    String
  score     Int
  level     Int
  duration  Int      // seconds played
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("game_scores")
}

// ---------------------------------------------------------------------------
// Social Media Manager — content calendar, post tracking, prompt library
// ---------------------------------------------------------------------------

enum PostStatus {
  idea
  drafted
  designed
  scheduled
  posted
  needs_follow_up
  archived
}

enum AssetType {
  image
  video
  canva_link
  exported_file
  background
  thumbnail
}

enum PromptCategory {
  canva_gpt
  image_background
  chatgpt_caption
  claude_development
  post_generation
  reply_style
}

model ContentSeries {
  id                   String   @id @default(cuid())
  name                 String
  description          String?
