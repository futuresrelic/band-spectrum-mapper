  songs    BandRpgSetlistSong[]
  concerts BandRpgConcert[]

  @@map("band_rpg_setlists")
}

model BandRpgSetlistSong {
  id        String   @id @default(cuid())
  setlistId String
  songId    String
  songTitle String
  rarity    String   @default("Common")
  position  Int
  addedAt   DateTime @default(now())

  setlist BandRpgSetlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)

  @@unique([setlistId, songId])
  @@map("band_rpg_setlist_songs")
}

model BandRpgVenue {
  id                  String   @id
  name                String
  description         String
  capacity            Int
  atmosphereAffinity  Int
  aggressionAffinity  Int
  complexityAffinity  Int
  emotionAffinity     Int
  psychedelicAffinity Int
  conceptAffinity     Int
  rarityBonus         Int
  createdAt           DateTime @default(now())

  concerts BandRpgConcert[]

  @@map("band_rpg_venues")
}

model BandRpgConcert {
  id             String   @id @default(cuid())
  userId         String
  bandId         String
  bandName       String
  concertName    String
  setlistId      String
  venueId        String?
  encorePosition Int?
  realWorldScore Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  setlist        BandRpgSetlist            @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  venue          BandRpgVenue?             @relation(fields: [venueId], references: [id], onDelete: SetNull)
  festivalEntries BandRpgFestivalConcert[]

  @@map("band_rpg_concerts")
}

// ---------------------------------------------------------------------------
// Festival Builder — Phase N
// A Festival is an ordered collection of Concerts.
// ---------------------------------------------------------------------------

model BandRpgFestival {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concerts BandRpgFestivalConcert[]

  @@map("band_rpg_festivals")
}

model BandRpgFestivalConcert {
  id         String   @id @default(cuid())
  festivalId String
  concertId  String
  position   Int
  addedAt    DateTime @default(now())

  festival BandRpgFestival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  concert  BandRpgConcert  @relation(fields: [concertId], references: [id], onDelete: Cascade)

  @@unique([festivalId, concertId])
  @@map("band_rpg_festival_concerts")
}

// ---------------------------------------------------------------------------
// Audience Profile — Music Identity Framework (Phase O)
// AI-scored 10-dimension profile describing who a song/album/band appeals to.
// Scale: 0-100. Separate from the lyric spectrum (0-10) and music spectrum (0-10).
// ---------------------------------------------------------------------------

model SongAudienceProfile {
  id              String   @id @default(cuid())
  songId          String   @unique
  model           String
  progressive     Float    @default(0)   // avant-garde, non-linear, complex structures
  heavy           Float    @default(0)   // physical weight, power, sonic mass
  technical       Float    @default(0)   // instrumental skill and compositional complexity
  atmospheric     Float    @default(0)   // mood, texture, immersion, ambience
  experimental    Float    @default(0)   // boundary-pushing, unconventional, unexpected
  accessible      Float    @default(0)   // easy on first listen, familiar structures
  psychedelic     Float    @default(0)   // mind-altering, surreal, consciousness-expanding
  emotional       Float    @default(0)   // emotional depth and impact
  aggressive      Float    @default(0)   // anger, intensity, confrontational energy
  improvisational Float    @default(0)   // spontaneity, live-feel, jazz-like freedom
  rationales      Json     @default("{}") // Record<dimensionKey, string> — one rationale per dimension
  contextJson     String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("song_audience_profiles")
}

model AlbumAudienceProfile {
  id              String   @id @default(cuid())
  albumId         String   @unique
  progressive     Float    @default(0)
  heavy           Float    @default(0)
  technical       Float    @default(0)
  atmospheric     Float    @default(0)
  experimental    Float    @default(0)
  accessible      Float    @default(0)
  psychedelic     Float    @default(0)
  emotional       Float    @default(0)
  aggressive      Float    @default(0)
  improvisational Float    @default(0)
  songCount       Int      @default(0)   // number of song profiles included in the average
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@map("album_audience_profiles")
}

model BandAudienceProfile {
  id              String   @id @default(cuid())
  bandId          String   @unique
  progressive     Float    @default(0)
  heavy           Float    @default(0)
  technical       Float    @default(0)
  atmospheric     Float    @default(0)
  experimental    Float    @default(0)
  accessible      Float    @default(0)
  psychedelic     Float    @default(0)
  emotional       Float    @default(0)
  aggressive      Float    @default(0)
  improvisational Float    @default(0)
  songCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@map("band_audience_profiles")
}

// Architectural placeholder for future Setlist.fm / real-world song data integration.
// No gameplay features write to this table yet; it exists so the Song relation
// resolves cleanly and the schema is ready when real-world data is available.
model BandRpgSongProfile {
  id          String   @id @default(cuid())
  songId      String   @unique
  trackRank   Float?   // future: relative play frequency rank from Setlist.fm (lower = performed more often)
  setlistFmId String?  // future: Setlist.fm song identifier
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("band_rpg_song_profiles")
}

