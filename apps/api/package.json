{
  "name": "@band-spectrum-mapper/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --schema=../../prisma/schema.prisma && tsc",
    "start": "node dist/index.js",
    "start:railway": "npx prisma db push --accept-data-loss --schema=../../prisma/schema.prisma && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate deploy --schema=../../prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=../../prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "prisma:seed": "tsx ../../prisma/seed.ts",
    "prisma:studio": "prisma studio --schema=../../prisma/schema.prisma"
  },
  "dependencies": {
    "@band-spectrum-mapper/shared": "*",
    "@prisma/client": "^5.14.0",
    "@resvg/resvg-js": "^2.6.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-html-parser": "^7.1.0",
    "openai": "^6.34.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "prisma": "^5.14.0",
    "tsx": "^4.15.5",
    "typescript": "^5.4.5"
  }
}
